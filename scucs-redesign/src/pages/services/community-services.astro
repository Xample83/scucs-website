---
import Layout from "../../layouts/Layout.astro";
import ServiceDetail from "../../components/ServiceDetail.astro";
import { services } from "../../data/services";

const service = services.find((s) => s.id === "community-services")!;
---

<Layout title={service.title} description={service.intro}>
  <section class="bg-brand-sky/10">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <a href="/services" class="inline-flex items-center gap-1 text-sm font-semibold text-brand-primary hover:underline">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All Services
      </a>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-brand-primary sm:text-5xl">{service.title}</h1>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <ServiceDetail service={service} />
  </section>

  <section aria-labelledby="cta-heading" class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl bg-brand-sky/10 px-6 py-12 text-center sm:px-12">
      <h2 id="cta-heading" class="text-2xl font-extrabold text-brand-primary sm:text-3xl">Explore Our Other Programs</h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-[var(--color-ink)]">
        SCUCS offers a full range of services to help older adults, adults with disabilities, and our neighbors facing homelessness.
      </p>
      <a
        href="/services"
        class="mt-6 inline-block rounded-md bg-brand-primary px-6 py-3 text-lg font-bold text-white shadow-sm hover:bg-brand-primary-dark"
      >
        View All Services
      </a>
    </div>
  </section>
</Layout>
