---
import Layout from "../../layouts/Layout.astro";
import { services } from "../../data/services";
import { path } from "../../utils/path";
---

<Layout
  title="Services"
  description="Explore SCUCS programs: Community Services, In-Home Services, Support Coordination, the Housing Supports Program, SEN-HAN Transit, and Travel & Tours for older adults, adults with disabilities, and our neighbors facing homelessness."
>
  <section class="bg-brand-sky/10">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-extrabold tracking-tight text-brand-primary sm:text-5xl">Our Services</h1>
      <p class="mt-6 text-xl leading-relaxed text-[var(--color-ink)]">
        SCUCS offers a range of programs designed to help older adults, adults with disabilities, and our neighbors
        facing homelessness live safely, independently, and with dignity across South Jersey &mdash; with Support
        Coordination and the Housing Supports Program available statewide.
      </p>
    </div>
  </section>

  <section aria-labelledby="services-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 id="services-heading" class="sr-only">All Programs</h2>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <li class="flex flex-col rounded-lg border border-slate-200 p-6 shadow-sm transition hover:shadow-md">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-sky/15">
            <svg class="h-8 w-8 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={service.icon} />
            </svg>
          </div>
          <h3 class="mt-4 text-xl font-bold text-brand-primary">{service.title}</h3>
          <p class="mt-2 flex-1 text-base leading-relaxed text-[var(--color-ink)]">{service.summary}</p>
          <a href={path(`/services/${service.id}`)} class="mt-4 inline-flex items-center font-semibold text-brand-primary hover:underline">
            Learn more<span class="sr-only"> about {service.title}</span>
            <span aria-hidden="true" class="ml-1">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="cta-heading" class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl bg-brand-primary px-6 py-12 text-center text-white sm:px-12">
      <h2 id="cta-heading" class="text-3xl font-extrabold sm:text-4xl">Not Sure Which Service Is Right for You?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-100">
        Our team can help you figure out which programs you or a loved one may qualify for.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="tel:+18564561121"
          class="w-full rounded-md bg-white px-6 py-3 text-center text-lg font-bold text-brand-primary shadow-sm hover:bg-slate-100 sm:w-auto"
        >
          Call (856) 456-1121
        </a>
        <a
          href={path("/contact-us")}
          class="w-full rounded-md border-2 border-white px-6 py-3 text-center text-lg font-bold text-white hover:bg-white hover:text-brand-primary sm:w-auto"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>
