---
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import RiskMitigationForm from "../../../components/RiskMitigationForm.astro";
import scucsLogo from "../../../assets/scucs-logo.png";
import { path } from "../../../utils/path";

const steps = [
  {
    n: "01",
    title: "Submit an application",
    text: "Provide information about yourself, your property, and the housing arrangement.",
  },
  {
    n: "02",
    title: "Upload documentation",
    text: "Submit the required documentation supporting your request.",
  },
  {
    n: "03",
    title: "SCUCS reviews your application",
    text: "SCUCS reviews eligibility and supporting documentation.",
  },
  {
    n: "04",
    title: "Funding decision",
    text: "Applicants are notified regarding the determination and any applicable next steps.",
  },
];
---

<Layout
  title="Risk Mitigation Fund"
  description="The Risk Mitigation Fund supports Camden County landlords who provide housing opportunities to vulnerable individuals."
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <div class="flex items-center gap-4">
        <a href={path("/")} class="flex-none">
          <Image src={scucsLogo} alt="SCUCS logo" class="h-12 w-auto" widths={[96, 144, 192]} sizes="96px" />
        </a>
        <div>
          <p class="text-xl font-extrabold text-brand-primary">The Risk Mitigation Fund</p>
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-accent-dark">Camden County Landlord Application Portal</p>
        </div>
      </div>
      <nav aria-label="Page sections" class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-brand-primary">
        <a href="#overview" class="hover:underline">Overview</a>
        <a href="#how-it-works" class="hover:underline">How it works</a>
        <a href="#apply" class="hover:underline">Apply</a>
      </nav>
    </div>
  </section>

  <section id="overview" class="bg-brand-sky/10">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <a
        href={path("/services/community-services")}
        class="inline-flex items-center gap-1 text-sm font-semibold text-brand-primary hover:underline"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Community Services
      </a>
      <p class="mt-6 text-sm font-semibold uppercase tracking-wide text-brand-accent-dark">The Risk Mitigation Fund</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-extrabold tracking-tight text-brand-primary sm:text-5xl">
        Supporting Camden County landlords who provide housing opportunities to vulnerable individuals.
      </h1>
      <p class="mt-6 max-w-3xl text-xl leading-relaxed text-[var(--color-ink)]">
        A program that helps reduce the financial concerns that can stand between a Camden County landlord and a housing
        placement that works for everyone.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a
          href="#apply"
          class="rounded-md bg-brand-primary px-8 py-4 text-center text-lg font-bold text-white shadow-sm hover:bg-brand-primary-dark"
        >
          Start an application
        </a>
        <a
          href="#how-it-works"
          class="rounded-md border-2 border-brand-primary px-8 py-4 text-center text-lg font-bold text-brand-primary hover:bg-brand-primary hover:text-white"
        >
          See how it works
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="intro-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 id="intro-heading" class="sr-only">About the Risk Mitigation Fund</h2>
    <p class="mx-auto max-w-3xl text-lg leading-relaxed text-[var(--color-ink)]">
      The Risk Mitigation Fund is designed to help reduce financial concerns that may prevent Camden County landlords
      from participating in affordable housing opportunities. Eligible landlords with properties in Camden County may
      apply for assistance related to qualifying losses or expenses, subject to program guidelines and available funding.
    </p>
  </section>

  <section id="how-it-works" aria-labelledby="how-heading" class="bg-brand-sky/10">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="how-heading" class="text-3xl font-extrabold text-brand-primary sm:text-4xl">How it works</h2>
      </div>
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step) => (
          <li class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-bold uppercase tracking-wide text-brand-accent-dark">{step.n}</p>
            <h3 class="mt-2 text-lg font-bold text-brand-primary">{step.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-[var(--color-ink)]">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="apply" aria-labelledby="apply-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <h2 id="apply-heading" class="text-3xl font-extrabold text-brand-primary sm:text-4xl">Landlord Application</h2>
      <p class="mt-3 text-lg text-[var(--color-ink)]">
        Fields marked <span class="font-semibold text-brand-danger">*</span> are required. You can gather your
        documentation before you begin &mdash; see the list in the upload section below.
      </p>
      <div class="mt-10">
        <RiskMitigationForm />
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <p class="text-center text-sm text-slate-600">
        The Risk Mitigation Fund &mdash; for Camden County landlords. This application is subject to program guidelines
        and available funding.
      </p>
    </div>
  </section>
</Layout>
