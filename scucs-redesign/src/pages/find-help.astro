    pdf: "https://scucs.org/wp-content/uploads/2026/07/EmergencyResources_RoomingHouses.pdf",
  },
];

function telHref(phone: string) {
  const digits = phone.replace(/[^0-9]/g, "");
  return `tel:+${digits.length === 10 ? "1" : ""}${digits}`;
}

function mapsHref(address: string) {
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
}
---

<Layout
  title="Find Help"
  description="Emergency and community resources from SCUCS: housing assistance, food pantries, sober living, assisted living, and important phone numbers for South Jersey residents in need."
>
  <section class="bg-brand-danger">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
      <p class="text-center text-lg font-bold text-white">
        In a life-threatening emergency, call 911 immediately.
      </p>
    </div>
  </section>

  <section class="bg-brand-sky/10">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-brand-primary sm:text-5xl">Find Help</h1>
        <p class="mt-6 text-xl leading-relaxed text-[var(--color-ink)]">
          Whether you need shelter tonight, help finding affordable housing, or a listing of local food pantries,
          this page brings together the community resources SCUCS relies on every day &mdash; all in one searchable
          place.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-5 text-center shadow-sm">
          <p class="text-2xl font-extrabold text-brand-primary">211</p>
          <p class="mt-1 text-base text-[var(--color-ink)]">Homeless or in crisis? Call 211 for immediate assistance.</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 text-center shadow-sm">
          <a href="tel:+18005727233" class="text-2xl font-extrabold text-brand-primary hover:underline">
            1-800-572-7233
          </a>
          <p class="mt-1 text-base text-[var(--color-ink)]">NJ Domestic Violence Hotline</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 text-center shadow-sm">
          <a href="tel:+18564561121" class="text-2xl font-extrabold text-brand-primary hover:underline">
            (856) 456-1121
          </a>
          <p class="mt-1 text-base text-[var(--color-ink)]">SCUCS Office &mdash; Mon&ndash;Fri, 9 AM&ndash;4 PM</p>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="directory-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 id="directory-heading" class="text-3xl font-extrabold text-brand-primary sm:text-4xl">Resource Directory</h2>
    <p class="mt-3 max-w-3xl text-lg text-[var(--color-ink)]">
      Search by name, town, or keyword, or filter by category. Each listing includes a phone number and address
      where available.
    </p>

    <div class="mt-8">
      <label for="resource-search" class="mb-2 block text-base font-semibold text-[var(--color-ink)]">
        Search resources
      </label>
      <input
        type="search"
        id="resource-search"
        placeholder="Search by name, town, or keyword&hellip;"
        class="w-full max-w-xl rounded-md border border-slate-300 px-4 py-3 text-lg text-[var(--color-ink)] focus:border-brand-primary"
      />
    </div>

    <div class="mt-6 flex flex-wrap gap-3" role="group" aria-label="Filter by category">
      <button type="button" data-category-filter="all" aria-pressed="true" class="filter-chip">All Categories</button>
      {categories.map((cat) => (
        <button type="button" data-category-filter={cat.id} aria-pressed="false" class="filter-chip">
          {cat.label}
        </button>
      ))}
    </div>

    <p id="results-count" class="mt-6 text-base font-semibold text-[var(--color-ink)]" aria-live="polite">
      Showing {resources.length} of {resources.length} resources
    </p>

    <ul id="resource-list" class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {resources.map((r) => {
        const categoryLabel = categories.find((c) => c.id === r.category)?.label ?? r.category;
        const searchBlob = [r.name, r.address, r.notes, categoryLabel].filter(Boolean).join(" ").toLowerCase();
        return (
          <li
            data-category={r.category}
            data-search={searchBlob}
            class="resource-card flex flex-col items-center rounded-lg border border-slate-200 p-5 text-center shadow-sm"
          >
            <span class="inline-block w-fit rounded-full bg-brand-sky/15 px-3 py-1 text-sm font-semibold text-brand-primary">
              {categoryLabel}
            </span>
            <h3 class="mt-3 text-lg font-bold text-brand-primary">{r.name}</h3>
            {r.address && (
              <p class="mt-1 text-base text-[var(--color-ink)]">
                {r.address}{" "}
                <a href={mapsHref(r.address)} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-primary hover:underline">
                  (Directions)
                </a>
              </p>
            )}
            {r.phone && (
              <p class="mt-1 text-base">
                <a href={telHref(r.phone)} class="font-semibold text-brand-primary hover:underline">{r.phone}</a>
                {r.phone2 && (
                  <>
                    {" "}or{" "}
                    <a href={telHref(r.phone2)} class="font-semibold text-brand-primary hover:underline">{r.phone2}</a>
                  </>
                )}
              </p>
            )}
            {r.email && (
              <p class="mt-1 text-base">
                <a href={`mailto:${r.email}`} class="text-brand-primary hover:underline">{r.email}</a>
              </p>
            )}
            {r.website && (
              <p class="mt-1 text-base">
                <a href={r.website} target="_blank" rel="noopener noreferrer" class="text-brand-primary hover:underline break-all">
                  {r.website.replace(/^https?:\/\//, "")}
                </a>
              </p>
            )}
            {r.notes && <p class="mt-2 flex-1 text-sm text-slate-600">{r.notes}</p>}
          </li>
        );
      })}
    </ul>

    <p id="no-results" class="mt-8 hidden text-center text-lg text-[var(--color-ink)]">
      No resources match your search. Try a different keyword, or call our office at
      <a href="tel:+18564561121" class="font-semibold text-brand-primary hover:underline">(856) 456-1121</a>
      for help.
    </p>

    <div class="mt-12 rounded-lg border-2 border-dashed border-brand-primary/40 bg-brand-sky/10 p-6">
      <h3 class="text-lg font-bold text-brand-primary">Prefer a printable version?</h3>
      <p class="mt-1 text-base text-[var(--color-ink)]">
        Download any category as a PDF to print or share.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        {categories.map((cat) => (
          <a
            href={cat.pdf}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md border-2 border-brand-primary bg-white px-4 py-2 text-base font-bold text-brand-primary shadow-sm hover:bg-brand-primary hover:text-white"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
            </svg>
            {cat.label} (PDF)
          </a>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="more-lists-heading" class="bg-brand-sky/10">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 id="more-lists-heading" class="text-3xl font-extrabold text-brand-primary sm:text-4xl">
        More Resource Lists
      </h2>
      <p class="mt-3 max-w-3xl text-lg text-[var(--color-ink)]">
        These larger lists are still available as printable PDFs while we finish bringing them onto the site.
      </p>

      <ul class="mt-8 grid gap-6 sm:grid-cols-3">
        {pdfOnlyResources.map((item) => (
          <li class="flex flex-col rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-brand-primary">{item.name}</h3>
            <p class="mt-2 flex-1 text-base text-[var(--color-ink)]">{item.description}</p>
            <a
              href={item.pdf}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex w-fit items-center rounded-md bg-brand-primary px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-brand-primary-dark"
            >
              Download PDF
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .filter-chip {
    border-radius: 9999px;
    border: 2px solid var(--color-brand-primary);
    background-color: white;
    color: var(--color-brand-primary);
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .filter-chip[aria-pressed="true"] {
    background-color: var(--color-brand-primary);
    color: white;
  }
</style>

<script>
  const searchInput = document.getElementById("resource-search") as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-category-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLLIElement>("#resource-list li"));
  const resultsCount = document.getElementById("results-count");
  const noResults = document.getElementById("no-results");

  let activeCategory = "all";

  function applyFilters() {
    const query = (searchInput?.value ?? "").trim().toLowerCase();
    let visibleCount = 0;

    for (const card of cards) {
      const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
      const matchesSearch = query === "" || (card.dataset.search ?? "").includes(query);
      const visible = matchesCategory && matchesSearch;
      card.classList.toggle("hidden", !visible);
      if (visible) visibleCount += 1;
    }

    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} resources`;
    }
    noResults?.classList.toggle("hidden", visibleCount !== 0);
  }

  searchInput?.addEventListener("input", applyFilters);

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      activeCategory = chip.dataset.categoryFilter ?? "all";
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      applyFilters();
    });
  });
</script>
