---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("news")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<Layout
  title="News"
  description="Read the latest news, announcements, and updates from Senior Citizens United Community Services (SCUCS)."
>
  <section class="bg-brand-sky/10">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-extrabold tracking-tight text-brand-primary sm:text-5xl">News &amp; Announcements</h1>
      <p class="mt-6 text-xl leading-relaxed text-[var(--color-ink)]">
        Updates on our programs, services, and the work we're doing across South Jersey.
      </p>
    </div>
  </section>

  <section aria-labelledby="posts-heading" class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 id="posts-heading" class="sr-only">Recent Posts</h2>

    {posts.length > 0 ? (
      <ul class="space-y-6">
        {posts.map((post) => (
          <li>
            <a
              href={`/news/${post.id}`}
              class="block rounded-lg border border-slate-200 p-6 shadow-sm transition hover:shadow-md"
            >
              <div class="flex flex-wrap items-center gap-3 text-sm">
                <span class="rounded-full bg-brand-sky/15 px-3 py-1 font-semibold text-brand-primary">
                  {post.data.category}
                </span>
                <time datetime={post.data.publishDate.toISOString()} class="text-slate-500">
                  {dateFormatter.format(post.data.publishDate)}
                </time>
              </div>
              <h3 class="mt-3 text-2xl font-bold text-brand-primary">{post.data.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-[var(--color-ink)]">{post.data.summary}</p>
              <span class="mt-4 inline-flex items-center font-semibold text-brand-primary hover:underline">
                Read more<span class="sr-only"> about {post.data.title}</span>
                <span aria-hidden="true" class="ml-1">&rarr;</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="rounded-2xl bg-brand-sky/10 p-8 text-center sm:p-12">
        <p class="text-lg text-[var(--color-ink)]">
          We don't have any news posted right now. Check back soon, or follow us on{" "}
          <a
            href="https://www.facebook.com/SCUCS-Inc-624076740946742/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-brand-primary hover:underline"
          >
            Facebook
          </a>{" "}
          for the latest updates.
        </p>
      </div>
    )}
  </section>

  <section aria-labelledby="follow-heading" class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl bg-brand-sky/10 px-6 py-10 text-center sm:px-12">
      <h2 id="follow-heading" class="text-2xl font-extrabold text-brand-primary sm:text-3xl">
        Stay Connected
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-[var(--color-ink)]">
        Follow us on Facebook for the latest updates, or contact us directly with any questions.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="https://www.facebook.com/SCUCS-Inc-624076740946742/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full rounded-md bg-brand-primary px-6 py-3 text-center text-lg font-bold text-white shadow-sm hover:bg-brand-primary-dark sm:w-auto"
        >
          Follow on Facebook
        </a>
        <a
          href="/contact-us"
          class="w-full rounded-md border-2 border-brand-primary px-6 py-3 text-center text-lg font-bold text-brand-primary hover:bg-brand-primary hover:text-white sm:w-auto"
        >
          Contact Us
        </a>
      </div>
      <p class="mt-6">
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-1.5 text-base font-semibold text-brand-primary hover:underline"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.18 17.82a2.18 2.18 0 100 4.36 2.18 2.18 0 000-4.36zM3 3v3.5c8.5 0 15.5 7 15.5 15.5H22C22 11.16 12.84 2 3 3zm0 7.5V14c4.7 0 8.5 3.8 8.5 8.5h3.5C15 15.6 9.4 10 3 10.5z" />
          </svg>
          Subscribe via RSS
        </a>
      </p>
    </div>
  </section>
</Layout>
