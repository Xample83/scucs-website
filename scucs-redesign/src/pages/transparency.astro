---
import Layout from "../layouts/Layout.astro";
import { path } from "../utils/path";

const factCards = [
  {
    label: "Tax-Exempt Status",
    value: "501(c)(3)",
    description: "SCUCS, Inc. is a federally recognized tax-exempt nonprofit organization.",
  },
  {
    label: "EIN",
    value: "22-2283793",
    description: "Our federal Employer Identification Number, as filed with the IRS.",
  },
  {
    label: "Serving South Jersey",
    value: "Since 1979",
    description: "Over 45 years of continuous service to Camden, Burlington, and Gloucester counties.",
  },
];
---

<Layout
  title="Transparency &amp; Accountability"
  description="Learn how SCUCS is governed and funded, including our 501(c)(3) status, EIN, and links to our publicly filed IRS Form 990 financial reports."
>
  <section class="bg-brand-sky/10">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-brand-primary sm:text-5xl">
          Transparency &amp; Accountability
        </h1>
        <p class="mt-6 text-xl leading-relaxed text-[var(--color-ink)]">
          As a nonprofit entrusted with public and donor funds, SCUCS is committed to open, honest reporting about
          how we're governed and how every dollar is used to serve our neighbors.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-3">
        {factCards.map((fact) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5 text-center shadow-sm">
            <p class="text-2xl font-extrabold text-brand-primary">{fact.value}</p>
            <p class="mt-1 text-base font-semibold text-brand-primary">{fact.label}</p>
            <p class="mt-1 text-sm text-[var(--color-ink)]">{fact.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="governance-heading" class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 id="governance-heading" class="text-3xl font-extrabold text-brand-primary sm:text-4xl">Our Governance</h2>
    <p class="mt-4 text-lg leading-relaxed text-[var(--color-ink)]">
      SCUCS is governed by a volunteer Board of Directors that provides independent oversight, sets our strategic
      direction, and holds the organization accountable to the community we serve. The Board meets regularly to
      review agency performance, finances, and programs.
    </p>
    <p class="mt-4 text-lg leading-relaxed text-[var(--color-ink)]">
      Have a question about our leadership or governance?{" "}
      <a href={path("/contact-us")} class="font-semibold text-brand-primary hover:underline">Contact our office</a>{" "}
      and we're happy to help.
    </p>
  </section>

  <section aria-labelledby="financials-heading" class="bg-brand-sky/10">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 id="financials-heading" class="text-3xl font-extrabold text-brand-primary sm:text-4xl">
        Financial Reports &amp; Form 990
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-[var(--color-ink)]">
        Every year, SCUCS files a Form 990 &mdash; a public financial disclosure required by the IRS for
        tax-exempt organizations &mdash; detailing our revenue, expenses, and programs. You can view our complete,
        official filing history, provided by the independent nonprofit journalism organization ProPublica.
      </p>
      <a
        href="https://projects.propublica.org/nonprofits/organizations/222283793"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-md bg-brand-primary px-6 py-3 text-lg font-bold text-white shadow-sm hover:bg-brand-primary-dark"
      >
        View Our Form 990 Filings
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <p class="mt-3 text-sm text-[var(--color-ink)]">
        Opens ProPublica's Nonprofit Explorer in a new tab &mdash; an independent, publicly accessible database of
        IRS filings.
      </p>
    </div>
  </section>

  <section aria-labelledby="impact-heading" class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h2 id="impact-heading" class="text-3xl font-extrabold text-brand-primary sm:text-4xl">
      Where Your Support Goes
    </h2>
    <p class="mt-4 text-lg leading-relaxed text-[var(--color-ink)]">
      93% of every dollar raised goes directly to services and activities that support our neighbors in need
      &mdash; in-home care, transportation, community programs, and emergency assistance.
    </p>
    <a href={path("/donate")} class="mt-6 inline-block font-semibold text-brand-primary hover:underline">
      See how you can give &rarr;
    </a>
  </section>
</Layout>
