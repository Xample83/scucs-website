---
import Layout from "../layouts/Layout.astro";
import FramedImage from "../components/FramedImage.astro";
import supportCoordinationPhoto from "../assets/support-coordination-photo.jpg";
import { path } from "../utils/path";

const contactCards = [
  {
    title: "Call Us",
    lines: ["(856) 456-1121"],
    href: "tel:+18564561121",
    linkLabel: "Call now",
    icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  },
  {
    title: "Email Us",
    lines: ["scucs@scucs.org"],
    href: "mailto:scucs@scucs.org",
    linkLabel: "Send an email",
    icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Visit Us",
    lines: ["537 W Nicholson Road", "Audubon, NJ 08106"],
    href: "https://www.google.com/maps/search/?api=1&query=537+W+Nicholson+Road+Audubon+NJ+08106",
    linkLabel: "Get directions",
    icon: "M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Office Hours",
    lines: ["Monday \u2013 Friday", "9:00 AM \u2013 4:00 PM"],
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  },
];
---

<Layout
  title="Contact Us"
  description="Get in touch with Senior Citizens United Community Services. Call, email, or visit our Audubon, NJ office."
>
  <section class="bg-brand-sky/10">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2 lg:px-8">
      <div class="text-center lg:text-left">
        <h1 class="text-4xl font-extrabold tracking-tight text-brand-primary sm:text-5xl">
          We're Here to Help
        </h1>
        <p class="mt-6 text-xl leading-relaxed text-[var(--color-ink)]">
          Have questions about our services, trips, or volunteer opportunities? Need help for yourself or a loved
          one? Reach out and a member of our team will get back to you.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a
            href="tel:+18564561121"
            class="w-full rounded-md bg-brand-primary px-8 py-4 text-center text-lg font-bold text-white shadow-sm hover:bg-brand-primary-dark sm:w-auto"
          >
            Call (856) 456-1121
          </a>
          <a
            href="mailto:scucs@scucs.org"
            class="w-full rounded-md border-2 border-brand-primary px-8 py-4 text-center text-lg font-bold text-brand-primary hover:bg-brand-primary hover:text-white sm:w-auto"
          >
            Email Us
          </a>
        </div>
      </div>

      <FramedImage
        class="order-first lg:order-last"
        src={supportCoordinationPhoto}
        alt="A support coordinator reviewing a support plan with an adult with a disability at a home office table"
      />
    </div>
  </section>

  <section aria-labelledby="contact-info-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 id="contact-info-heading" class="sr-only">Contact Information</h2>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {contactCards.map((card) => (
        <li class="flex flex-col items-center rounded-lg border border-slate-200 p-6 text-center shadow-sm">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-sky/15">
            <svg class="h-8 w-8 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={card.icon} />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-bold text-brand-primary">{card.title}</h3>
          <p class="mt-2 text-base leading-relaxed text-[var(--color-ink)]">
            {card.lines.map((line, i) => (
              <>
                {line}
                {i < card.lines.length - 1 && <br />}
              </>
            ))}
          </p>
          {card.href && (
            <a
              href={card.href}
              target={card.href.startsWith("http") ? "_blank" : undefined}
              rel={card.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="mt-4 inline-flex items-center font-semibold text-brand-primary hover:underline"
            >
              {card.linkLabel}
              <span aria-hidden="true" class="ml-1">&rarr;</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="map-heading" class="bg-brand-sky/10">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="map-heading" class="text-3xl font-extrabold text-brand-primary sm:text-4xl">Find Our Office</h2>
        <p class="mt-4 text-lg text-[var(--color-ink)]">
          537 W Nicholson Road, Audubon, NJ 08106
        </p>
      </div>
      <div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-2xl border-4 border-brand-primary shadow-lg">
        <iframe
          title="Map showing SCUCS office at 537 W Nicholson Road, Audubon, NJ 08106"
          src="https://www.google.com/maps?q=537+W+Nicholson+Road,+Audubon,+NJ+08106&output=embed"
          class="h-96 w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <section aria-labelledby="cta-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl bg-brand-primary px-6 py-12 text-center text-white sm:px-12">
      <h2 id="cta-heading" class="text-3xl font-extrabold sm:text-4xl">
        Looking for Emergency or Community Resources?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-100">
        Visit our Find Help directory for housing, shelter, and assistance resources you can search right now.
      </p>
      <div class="mt-8 flex justify-center">
        <a
          href={path("/find-help")}
          class="rounded-md bg-white px-6 py-3 text-center text-lg font-bold text-brand-primary shadow-sm hover:bg-slate-100"
        >
          Go to Find Help
        </a>
      </div>
    </div>
  </section>
</Layout>
