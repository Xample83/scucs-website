---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  rounded?: "2xl" | "lg";
  offset?: "sm" | "md";
  shadow?: string;
  class?: string;
}

const {
  src,
  alt,
  widths = [400, 600, 800],
  sizes = "(min-width: 1024px) 560px, 100vw",
  rounded = "2xl",
  offset = "md",
  shadow = "shadow-xl",
  class: className,
} = Astro.props;

const roundedClass = rounded === "2xl" ? "rounded-2xl" : "rounded-lg";
const offsetClass = offset === "md" ? "-bottom-4 -right-4" : "-bottom-2 -right-2";
---

<div class:list={["relative aspect-4/3", className]}>
  <div class:list={["absolute h-full w-full bg-brand-sky", roundedClass, offsetClass]} aria-hidden="true"></div>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    class:list={["relative z-10 aspect-4/3 w-full border-4 border-white object-cover", roundedClass, shadow]}
  />
</div>
