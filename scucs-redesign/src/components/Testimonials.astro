---
import { testimonials } from "../data/testimonials";

interface Props {
  heading?: string;
  intro?: string;
  /** Limit how many quotes to show. Defaults to all. */
  limit?: number;
  /** Section background. Use "white" when placing next to another sky-tinted band. */
  tone?: "sky" | "white";
}

const {
  heading = "Stories From Our Community",
  intro = "A few words from the people we serve, their families, and the volunteers who make our work possible.",
  limit,
  tone = "sky",
} = Astro.props;

const items = typeof limit === "number" ? testimonials.slice(0, limit) : testimonials;
const sectionClass = tone === "white" ? "bg-white" : "bg-brand-sky/10";
const gridClass =
  items.length === 1
    ? "mx-auto mt-12 max-w-xl"
    : items.length === 2
      ? "mx-auto mt-12 grid max-w-4xl gap-10 sm:grid-cols-2 lg:gap-12"
      : "mx-auto mt-12 grid max-w-5xl gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-12";
---

{
  items.length > 0 && (
    <section aria-labelledby="testimonials-heading" class={sectionClass}>
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 id="testimonials-heading" class="text-3xl font-extrabold text-brand-primary sm:text-4xl">
            {heading}
          </h2>
          <p class="mt-4 text-lg text-[var(--color-ink)]">{intro}</p>
        </div>

        <ul class={gridClass}>
          {items.map((item) => (
            <li>
              <figure class="h-full">
                <blockquote class="relative text-lg leading-relaxed text-[var(--color-ink)]">
                  <span
                    class="absolute -top-3 -left-1 text-5xl font-bold leading-none text-brand-sky/40 select-none"
                    aria-hidden="true"
                  >
                    &ldquo;
                  </span>
                  <p class="pl-6">{item.quote}</p>
                </blockquote>
                <figcaption class="mt-5 border-t border-brand-sky/30 pt-4 pl-6">
                  <p class="font-bold text-brand-primary">{item.name}</p>
                  {(item.role || item.program) && (
                    <p class="mt-0.5 text-base text-slate-600">
                      {[item.role, item.program].filter(Boolean).join(" · ")}
                    </p>
                  )}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
