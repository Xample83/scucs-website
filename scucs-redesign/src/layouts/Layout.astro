---
import "../styles/global.css";
import { Image } from "astro:assets";
import scucsLogo from "../assets/scucs-logo.png";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Senior Citizens United Community Services (SCUCS) is a nonprofit dedicated to enhancing the quality of life and independence of older adults, adults with disabilities, and individuals facing homelessness in South Jersey.",
  image = "/og-image.png",
  type = "website",
} = Astro.props;

const pageTitle = `${title} | SCUCS`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImageUrl = new URL(image, Astro.site).toString();
const logoUrl = new URL("/logo.png", Astro.site).toString();

// Set PUBLIC_GA_MEASUREMENT_ID in a .env file (local) or your host's environment
// variable settings (production) once a GA4 property has been created. See .env.example.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const shouldLoadAnalytics = Boolean(gaMeasurementId) && import.meta.env.PROD;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "Senior Citizens United Community Services",
  alternateName: "SCUCS",
  url: Astro.site?.toString(),
  logo: logoUrl,
  image: socialImageUrl,
  description:
    "Senior Citizens United Community Services (SCUCS) is a not-for-profit social service agency dedicated to enhancing the quality of life, encouraging independence, and providing a safe and supportive living environment for older adults, adults with disabilities, and individuals facing homelessness in South Jersey.",
  telephone: "+1-856-456-1121",
  email: "mailto:scucs@scucs.org",
  address: {
    "@type": "PostalAddress",
    streetAddress: "537 W Nicholson Road",
    addressLocality: "Audubon",
    addressRegion: "NJ",
    postalCode: "08106",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Camden County, NJ" },
    { "@type": "AdministrativeArea", name: "Burlington County, NJ" },
    { "@type": "AdministrativeArea", name: "Gloucester County, NJ" },
  ],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "16:00",
  },
  sameAs: ["https://www.facebook.com/SCUCS-Inc-624076740946742/"],
};

const primaryNavLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/volunteer", label: "Volunteer" },
  { href: "/news", label: "News" },
  { href: "/about-us", label: "About Us" },
  { href: "/contact-us", label: "Contact Us" },
];

const footerQuickLinks = [
  { href: "/", label: "Home" },
  { href: "/find-help", label: "Find Help" },
  ...primaryNavLinks.slice(1),
  { href: "/transparency", label: "Transparency" },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c5aa0" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="SCUCS News" href="/rss.xml" />
    <title>{pageTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="SCUCS" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Senior Citizens United Community Services logo on a blue background" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    {shouldLoadAnalytics && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(...args) {
            dataLayer.push(args);
          }
          gtag("js", new Date());
          gtag("config", gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-white">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-primary focus:px-4 focus:py-3 focus:text-white focus:shadow-lg"
    >
      Skip to main content
    </a>

    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white">
      <nav aria-label="Primary" class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2" aria-label="Senior Citizens United Community Services - Home">
          <Image
            src={scucsLogo}
            alt=""
            width={205}
            height={155}
            class="h-16 w-auto sm:h-20"
          />
        </a>

        <ul class="hidden items-center gap-6 text-base font-semibold text-[var(--color-ink)] lg:flex">
          {primaryNavLinks.map((link) => (
            <li>
              <a href={link.href} class="rounded-sm hover:text-brand-primary hover:underline">
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="hidden items-center gap-4 lg:flex">
          <a href="tel:+18564561121" class="font-semibold text-brand-primary hover:underline">
            (856) 456-1121
          </a>
          <a
            href="/donate"
            class="rounded-md bg-brand-accent px-5 py-2.5 text-base font-bold text-white shadow-sm hover:bg-brand-accent-dark"
          >
            Donate
          </a>
          <a
            href="/find-help"
            class="rounded-md bg-brand-danger px-5 py-2.5 text-base font-bold text-white shadow-sm hover:bg-brand-danger-dark"
          >
            Find Help
          </a>
        </div>

        <button
          type="button"
          id="mobile-menu-button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle menu"
          class="inline-flex items-center justify-center rounded-md border border-slate-300 p-2.5 text-brand-primary lg:hidden"
        >
          <svg id="menu-icon-open" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </nav>

      <div id="mobile-menu" class="hidden border-t border-slate-200 lg:hidden">
        <ul class="flex flex-col gap-1 px-4 py-4 text-base font-semibold text-[var(--color-ink)] sm:px-6">
          {primaryNavLinks.map((link) => (
            <li>
              <a href={link.href} class="block rounded-md px-3 py-3 hover:bg-slate-100 hover:text-brand-primary">
                {link.label}
              </a>
            </li>
          ))}
          <li class="mt-2 flex flex-col gap-3 border-t border-slate-200 pt-4">
            <a href="tel:+18564561121" class="font-semibold text-brand-primary">
              Call (856) 456-1121
            </a>
            <a
              href="/donate"
              class="rounded-md bg-brand-accent px-5 py-3 text-center text-base font-bold text-white shadow-sm hover:bg-brand-accent-dark"
            >
              Donate
            </a>
            <a
              href="/find-help"
              class="rounded-md bg-brand-danger px-5 py-3 text-center text-base font-bold text-white shadow-sm hover:bg-brand-danger-dark"
            >
              Find Help
            </a>
          </li>
        </ul>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="bg-brand-primary text-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3 lg:px-8">
        <div>
          <div class="inline-block rounded-lg bg-white p-3">
            <Image
              src={scucsLogo}
              alt="Senior Citizens United Community Services"
              width={205}
              height={155}
              class="h-20 w-auto"
            />
          </div>
          <h2 class="mt-4 text-xl font-bold text-white">Senior Citizens United Community Services</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-200">
            A not-for-profit social service agency dedicated to enhancing the quality of life, encouraging
            independence, and providing a safe and supportive living environment for older adults, adults with
            disabilities, and individuals facing homelessness.
          </p>
          <div class="mt-6 flex gap-4">
            <a href="https://www.facebook.com/SCUCS-Inc-624076740946742/" class="rounded-md border border-white/40 px-4 py-2 text-sm font-semibold hover:bg-white/10" aria-label="Follow SCUCS on Facebook" target="_blank" rel="noopener noreferrer">
              Facebook
            </a>
          </div>
        </div>

        <div>
          <h2 class="text-xl font-bold text-white">Quick Links</h2>
          <ul class="mt-4 space-y-2 text-base text-slate-200">
            {footerQuickLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-xl font-bold text-white">Contact Us</h2>
          <address class="mt-4 space-y-2 text-base not-italic text-slate-200">
            <p>537 W Nicholson Road<br />Audubon, NJ 08106</p>
            <p>
              <a href="tel:+18564561121" class="hover:text-white hover:underline">(856) 456-1121</a>
            </p>
            <p>
              <a href="mailto:scucs@scucs.org" class="hover:text-white hover:underline">scucs@scucs.org</a>
            </p>
            <p>Monday &ndash; Friday, 9 AM &ndash; 4 PM</p>
          </address>
        </div>
      </div>

      <div class="border-t border-white/20 py-6">
        <p class="mx-auto max-w-7xl px-4 text-sm text-slate-300 sm:px-6 lg:px-8">
          &copy; {currentYear} Senior Citizens United Community Services, Inc. All rights reserved.
        </p>
      </div>
    </footer>

    <script>
      const menuButton = document.getElementById("mobile-menu-button");
      const mobileMenu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("menu-icon-open");
      const iconClose = document.getElementById("menu-icon-close");

      function closeMenu() {
        mobileMenu?.classList.add("hidden");
        menuButton?.setAttribute("aria-expanded", "false");
        iconOpen?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
      }

      function openMenu() {
        mobileMenu?.classList.remove("hidden");
        menuButton?.setAttribute("aria-expanded", "true");
        iconOpen?.classList.add("hidden");
        iconClose?.classList.remove("hidden");
      }

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        isOpen ? closeMenu() : openMenu();
      });

      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
        }
      });
    </script>
  </body>
</html>
